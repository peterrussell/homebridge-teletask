{
  "name": "homebridge-teletask",
  "displayName": "Homebridge Teletask",
  "version": "0.1.0",
  "description": "Homebridge plugin that bridges TELETASK DoIP relays, dimmers, blinds and sensors into Apple HomeKit, using the teletask-api library.",
  "main": "index.js",
  "engines": {
    "node": ">=18",
    "homebridge": "^1.6.0 || ^2.0.0"
  },
  "scripts": {
    "bundle": "node scripts/bundle-lib.mjs",
    "prepublishOnly": "node scripts/bundle-lib.mjs"
  },
  "files": [
    "index.js",
    "src",
    "lib",
    "scripts",
    "config.schema.json",
    "README.md"
  ],
  "keywords": [
    "homebridge-plugin",
    "teletask",
    "doip",
    "home-automation",
    "homekit"
  ],
  "author": "Peter Russell",
  "license": "MIT"
}

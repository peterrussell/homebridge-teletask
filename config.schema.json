{
  "pluginAlias": "Teletask",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Bridges TELETASK DoIP devices into HomeKit. Requires an active TDS15132 (DoIP Open Protocol) license on your central unit — see the plugin README.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Teletask",
        "required": true
      },
      "host": {
        "title": "Central unit IP address",
        "type": "string",
        "format": "ipv4",
        "required": true,
        "placeholder": "192.168.1.113"
      },
      "port": {
        "title": "Port",
        "type": "integer",
        "default": 55957,
        "description": "DoIP port — leave at 55957 unless you changed it in PROSOFT."
      },
      "centralUnit": {
        "title": "Default central unit",
        "type": "integer",
        "default": 1,
        "description": "Central unit index (1 = 'A')."
      },
      "autoDiscover": {
        "title": "Auto-discover outputs on startup",
        "type": "boolean",
        "default": true,
        "description": "Probe the unit at startup and add any new outputs. Uncheck to disable."
      },
      "accessories": {
        "title": "Accessories",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": true
            },
            "type": {
              "title": "Type",
              "type": "string",
              "default": "light",
              "oneOf": [
                { "title": "Light (relay)", "enum": ["light"] },
                { "title": "Switch (relay)", "enum": ["switch"] },
                { "title": "Fan (relay)", "enum": ["fan"] },
                { "title": "Outlet (relay)", "enum": ["outlet"] },
                { "title": "Dimmer", "enum": ["dimmer"] },
                { "title": "Blind / Window Covering (motor)", "enum": ["blind"] },
                { "title": "Thermostat / climate zone", "enum": ["thermostat"] },
                { "title": "Heating zone (same as thermostat)", "enum": ["heating"] },
                { "title": "Temperature sensor", "enum": ["sensor"] }
              ],
              "required": true
            },
            "outputId": {
              "title": "Output #",
              "type": "integer",
              "required": true,
              "description": "Output number from PROSOFT (GUISOFT → Define Output)."
            },
            "visible": {
              "title": "Visible in HomeKit",
              "type": "boolean",
              "default": true,
              "description": "Uncheck to keep in config but hide from HomeKit."
            },
            "centralUnit": {
              "title": "Central unit (optional)",
              "type": "integer",
              "description": "Overrides the default central unit for this accessory."
            },
            "invertPosition": {
              "title": "Invert blind position",
              "type": "boolean",
              "default": false,
              "description": "Flip if open/closed is reversed."
            },
            "climate": {
              "title": "Climate mode",
              "type": "string",
              "default": "auto",
              "oneOf": [
                { "title": "Heat only (radiator)", "enum": ["heat"] },
                { "title": "Cool only (AC)", "enum": ["cool"] },
                { "title": "Heat + Cool + Auto", "enum": ["auto"] }
              ],
              "description": "Modes the zone supports."
            },
            "temperatureFrom": {
              "title": "Borrow temperature from zone",
              "type": "integer",
              "description": "Read temperature from another zone (for AC with no sensor of its own)."
            },
            "powerRelay": {
              "title": "On/off via relay",
              "type": "integer",
              "description": "Relay output used for true on/off."
            },
            "minBrightness": {
              "title": "Min level (HomeKit 1%)",
              "type": "integer",
              "description": "Teletask level (0-100) at HomeKit 1%."
            },
            "maxBrightness": {
              "title": "Max level (HomeKit 100%)",
              "type": "integer",
              "description": "Teletask level (0-100) at HomeKit 100% (e.g. 75)."
            }
          }
        }
      }
    }
  },
  "layout": [
    "name",
    "host",
    {
      "type": "flex",
      "flex-flow": "row wrap",
      "items": ["port", "centralUnit"]
    },
    "autoDiscover",
    {
      "key": "accessories",
      "type": "array",
      "title": "Accessories",
      "expandable": true,
      "expanded": false,
      "items": [
        "accessories[].name",
        {
          "type": "flex",
          "flex-flow": "row wrap",
          "items": ["accessories[].type", "accessories[].outputId"]
        },
        "accessories[].visible",
        {
          "key": "accessories[].invertPosition",
          "condition": {
            "functionBody": "var i = Array.isArray(arrayIndices) ? arrayIndices[arrayIndices.length - 1] : arrayIndices; var a = model.accessories[i]; return !!a && a.type === 'blind';"
          }
        },
        {
          "type": "flex",
          "flex-flow": "row wrap",
          "condition": {
            "functionBody": "var i = Array.isArray(arrayIndices) ? arrayIndices[arrayIndices.length - 1] : arrayIndices; var a = model.accessories[i]; return !!a && a.type === 'dimmer';"
          },
          "items": ["accessories[].minBrightness", "accessories[].maxBrightness"]
        },
        {
          "key": "accessories[].climate",
          "condition": {
            "functionBody": "var i = Array.isArray(arrayIndices) ? arrayIndices[arrayIndices.length - 1] : arrayIndices; var a = model.accessories[i]; return !!a && (a.type === 'thermostat' || a.type === 'heating');"
          }
        },
        {
          "key": "accessories[].temperatureFrom",
          "condition": {
            "functionBody": "var i = Array.isArray(arrayIndices) ? arrayIndices[arrayIndices.length - 1] : arrayIndices; var a = model.accessories[i]; return !!a && (a.type === 'thermostat' || a.type === 'heating');"
          }
        },
        {
          "key": "accessories[].powerRelay",
          "condition": {
            "functionBody": "var i = Array.isArray(arrayIndices) ? arrayIndices[arrayIndices.length - 1] : arrayIndices; var a = model.accessories[i]; return !!a && (a.type === 'dimmer' || a.type === 'thermostat' || a.type === 'heating');"
          }
        }
      ]
    }
  ]
}
